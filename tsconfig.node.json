{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "packages/core/src/**/*",
    "packages/modules/rss/src/main/**/*",
    "packages/modules/code/src/main/**/*",
    "packages/modules/base/src/main/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "types": [
      "electron-vite/node"
    ],
    "paths": {
      "@citadel-app/sdk": [
        "packages/sdk/src/index.ts"
      ],
      "@citadel-app/*": [
        "packages/*",
        "packages/modules/*"
      ],
      "@shared": [
        "src/shared/index.ts"
      ],
      "@shared/*": [
        "src/shared/*"
      ]
    }
  }
}