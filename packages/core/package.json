{
  "name": "@citadel-app/core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/citadel-app/citadel.git"
  },
  "version": "1.2.1",
  "main": "./dist/index.node.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.node.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/index.node.d.ts",
        "import": "./dist/index.node.js",
        "require": "./dist/index.node.cjs"
      },
      "browser": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.node.js",
        "require": "./dist/index.node.cjs"
      }
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint src/",
    "build": "tsc -b --force && vite build",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^5.5.3"
  }
}
