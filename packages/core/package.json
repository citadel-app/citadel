{
  "name": "@citadel-app/core",
  "repository": {
    "type": "git",
    "url": "https://github.com/citadel-app/citadel.git"
  },
  "version": "1.0.0",
  "main": "./dist/index.node.js",
  "module": "./dist/index.js",
  "types": "./dist/index.node.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/index.js",
      "node": "./dist/index.node.js",
      "default": "./dist/index.node.js"
    },
    "./ai/*": "./dist/ai/*",
    "./commands/*": "./dist/commands/*",
    "./serializers/*": "./dist/serializers/*",
    "./settings/*": "./dist/settings/*",
    "./types/*": "./dist/types/*",
    "./codex/*": "./dist/codex/*",
    "./src/renderer/*": "./dist/renderer/*"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "scripts": {
    "lint": "eslint src/",
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^5.5.3"
  }
}