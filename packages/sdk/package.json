{
  "name": "@citadel-app/sdk",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/citadel-app/citadel.git"
  },
  "description": "Public Plugin SDK for Citadel Workspace",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && vite build"
  },
  "dependencies": {
    "@citadel-app/core": "*"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
