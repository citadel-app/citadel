{
  "name": "citadel",
  "version": "1.1.1",
  "description": "a hackable second brain for software developers",
  "main": "./out/main/index.js",
  "author": "Citadel",
  "homepage": "https://github.com/iwannabebot/citadel",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --x64 && electron-builder --win --arm64",
    "build:mac": "npm run build && electron-builder --mac --universal",
    "build:linux": "npm run build && electron-builder --linux --x64 && electron-builder --linux --arm64",
    "copy-assets": "node scripts/copy-excalidraw-assets.js",
    "start:server": "python src/python/tts_server.py",
    "dev:all": "concurrently --kill-others \"npm run dev\" \"npm run start:server\"",
    "clean": "npm run clean:build",
    "clean:build": "node scripts/clean.js",
    "changelog:generate": "node scripts/generate-changelog-entries.js",
    "generate-icons": "scripts/generate-icons.sh"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tiptap/extension-bubble-menu": "^3.19.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^3.6.0",
    "buffer": "^6.0.3",
    "fs-extra": "^11.3.3",
    "react-virtualized-auto-sizer": "^2.0.3",
    "simple-git": "^3.30.0",
    "systeminformation": "^5.30.7",
    "uuid": "^13.0.0",
    "ws": "^8.19.0"
  },
