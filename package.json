{
  "name": "@citadel-app/app",
  "version": "1.2.2",
  "description": "a hackable second brain for software developers",
  "main": "./out/main/index.js",
  "author": "Citadel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/citadel-app/citadel.git"
  },
  "homepage": "https://github.com/citadel-app/citadel",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "files": [
    "out",
    "docs",
    "package.json"
  ],
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "node scripts/dev-wrapper.js",
    "build": "npm run version:sync && npm run typecheck && npm run docs:generate && cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "clean": "npm run clean:build",
    "clean:build": "node scripts/clean.js",
    "changelog:generate": "node scripts/generate-changelog-entries.js",
    "generate-icons": "scripts/generate-icons.sh",
    "docs:extract-logic": "tsx scripts/doc-builder.ts --stage extract-logic",
    "docs:extract-ui": "tsx scripts/doc-builder.ts --stage extract-ui",
    "docs:merge": "tsx scripts/doc-builder.ts --stage merge",
    "docs:generate": "tsx scripts/doc-builder.ts",
    "docs:watch": "nodemon --watch packages --ext ts,tsx --exec \"npm run docs:generate\"",
    "version:sync": "npx tsx scripts/sync-all-versions.ts"
  },
  "dependencies": {
    "@tiptap/extension-bubble-menu": "^3.19.0",
    "better-sqlite3": "^12.6.2",
    "buffer": "^6.0.3",
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.3",
    "fs-extra": "^11.3.3",
    "react-virtualized-auto-sizer": "^2.0.3",
    "simple-git": "^3.30.0",
    "systeminformation": "^5.30.7",
    "uuid": "^9.0.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^4.0.3",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/extension-code-block-lowlight": "^3.19.0",
    "@tiptap/extension-image": "^3.19.0",
    "@tiptap/extension-mathematics": "^3.19.0",
    "@tiptap/extension-table": "^3.19.0",
    "@tiptap/extension-table-cell": "^3.19.0",
    "@tiptap/extension-table-header": "^3.19.0",
    "@tiptap/extension-table-row": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.19.1",
    "@types/peerjs": "^0.0.30",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/react-window": "^1.8.8",
    "@typescript/ata": "^0.9.8",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^4.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "es6-promise-pool": "^2.5.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "vscode-jsonrpc": "^8.2.0",
    "katex": "^0.16.28",
    "liquidjs": "^10.24.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.563.0",
    "mermaid": "^11.12.2",
    "next-themes": "^0.4.6",
    "nodemon": "^3.1.14",
    "peerjs": "^1.5.5",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "react-window": "^1.8.10",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "semver": "^7.7.4",
    "simple-icons": "^16.7.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.17",
    "tiptap-markdown": "^0.9.0",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "workspaces": [
    "packages/*",
    "packages/modules/base"
  ]
}
